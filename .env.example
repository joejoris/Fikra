# ---------------------------------------------------------------------------
# FIKRA site environment variables
# Copy this file to `.env` for local work. Never commit `.env`.
# ---------------------------------------------------------------------------

# Public: where forms POST to. Leave as the default in production so the
# bundled Cloudflare Pages Function handles it.
PUBLIC_FORM_ENDPOINT=/api/contact

# Public: cookie-free analytics. Leave blank to disable the analytics script.
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=

# Server-only (Cloudflare Pages environment variables, not exposed to the browser):
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=info@fikra.example.org
# CONTACT_FROM_EMAIL="FIKRA Website <website@fikra.example.org>"
# TURNSTILE_SECRET_KEY=
# Newsletter sign-ups (Resend Audience — Dashboard → Audiences):
# RESEND_AUDIENCE_ID=
# Submissions inbox (private page at /inbox). Set a strong password.
# INBOX_PASSWORD=
