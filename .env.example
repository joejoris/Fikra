# ---------------------------------------------------------------------------
# FIKRA site environment variables (Render web service + local `npm run server`)
# Public values go in `.env` for Astro; server-only values go in the Render
# dashboard (or `.dev.vars` locally, which is gitignored). Never commit secrets.
# ---------------------------------------------------------------------------

# Public: where forms POST to. Same-origin API served by the Node server.
PUBLIC_FORM_ENDPOINT=/api/contact

# Public: cookie-free analytics. Leave blank to disable the analytics script.
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=

# Public: Cloudflare Web Analytics beacon token (Dashboard → Analytics → Web
# Analytics → Add a site → copy the token). Leave blank to disable. Free and
# cookieless — no cookie banner needed.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Server-only (Render environment variables, not exposed to the browser):
# Postgres connection string (Supabase). Leave unset for local SQLite (./data/app.db).
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres
# Outgoing mail — pick ONE provider:
# 1) Resend (API + audience list):
# RESEND_API_KEY=re_xxxxxxxx
# Newsletter sign-ups join this Resend Audience (Dashboard → Audiences):
# RESEND_AUDIENCE_ID=
# 2) Gmail SMTP via the address below (Google Account → Security → 2-Step
#    Verification → App passwords). Newsletters are recorded locally instead
#    of joining an external list.
# GMAIL_USER=fikrainnovator@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# CONTACT_TO_EMAIL=fikrainnovator@gmail.com
# CONTACT_FROM_EMAIL="FIKRA Website <website@fikra.example.org>"
# Turnstile spam protection: the widget renders automatically once the site key
# is set, and the server verifies it once the secret is set. Set BOTH together —
# a secret without the widget rejects every submission.
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Newsletter sign-ups (Resend Audience — Dashboard → Audiences):
# RESEND_AUDIENCE_ID=
# PayPal donations (Orders API — developer.paypal.com → Apps & Credentials):
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# Sandbox or live. Use sandbox until real money is tested end-to-end.
# PAYPAL_MODE=sandbox
# Currency code for donations (e.g. USD).
# PAYPAL_CURRENCY=USD
# Webhook ID for PAYPAL.CAPTURE.COMPLETED (App → Webhooks → Add Webhook).
# PAYPAL_WEBHOOK_ID=
# M-Pesa donations (Safaricom Daraja — developer.safaricom.co.ke → Apps):
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# Shortcode + passkey from the Daraja app (sandbox numbers work for testing).
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# Sandbox or live. Use sandbox until real money is tested end-to-end.
# MPESA_MODE=sandbox
# Submissions inbox (private page at /inbox). Set a strong password.
# INBOX_PASSWORD=
# Port the server listens on (Render injects PORT automatically).
# PORT=3000
