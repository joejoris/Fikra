# ---------------------------------------------------------------------------
# Cloudflare Pages security headers (applied to every route in production).
# Local `astro preview` and `wrangler pages dev` do not apply these; they are
# served by Cloudflare Pages when the bundle is deployed.
#
# If you add third-party scripts (maps, chat widgets, analytics domains),
# extend the Content-Security-Policy below — in particular `script-src` and
# `connect-src`.
# ---------------------------------------------------------------------------

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self'