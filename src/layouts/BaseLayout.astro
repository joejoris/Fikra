---
interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

import { SITE } from '../lib/site';
import Header from '../components/Header.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import BackToTop from '../components/BackToTop.astro';
import ChatWidget from '../components/ChatWidget.astro';
import '../styles/global.css';

const {
  title,
  description = SITE.description,
  image = '/og-default.svg',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const pageTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image, Astro.site ?? SITE.url).href;

// The floating chat widget appears everywhere except /community, which shows
// the full inline chat room instead.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const showChatWidget = currentPath !== '/community';

const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC;
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN;
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;

const socialUrls = Object.values(SITE.social).filter(Boolean);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  sameAs: socialUrls,
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/icon-16.png" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <meta name="theme-color" content="#0e6e6e" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="FIKRA news" href="/rss.xml" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <!-- Open Graph / social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {analyticsSrc && (
      <script
        is:inline
        defer
        data-domain={analyticsDomain}
        src={analyticsSrc}
      ></script>
    )}

    {cfAnalyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}
      ></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <AnnouncementBar />
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <BackToTop />
    {showChatWidget && <ChatWidget />}

    <script is:inline>
      // Scroll-reveal: CSS hides [data-reveal] only once this runs, so
      // content stays visible with JavaScript disabled or failed.
      document.documentElement.classList.add('js');
      const targets = document.querySelectorAll('[data-reveal]:not(.is-visible)');
      if (!('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>

    {
      import.meta.env.PROD && (
        <script is:inline>
          // Lite offline support: register the service worker on production only,
          // so local dev never serves stale cached pages.
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
              navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' }).catch(() => {
                /* optional — the site works fine with or without it */
              });
            });
          }
        </script>
      )
    }
  </body>
</html>
