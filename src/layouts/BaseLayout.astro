---
interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  lang?: 'en' | 'am';
}

import { SITE } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import BackToTop from '../components/BackToTop.astro';
import { useTranslations, localizePath, logicalPath, type Lang } from '../i18n/ui';
import '../styles/global.css';

const {
  title,
  description = SITE.description,
  image = '/og-default.svg',
  ogType = 'website',
  noindex = false,
  lang: langProp,
} = Astro.props;

const lang: Lang = langProp ?? (Astro.currentLocale === 'am' ? 'am' : 'en');
const t = useTranslations(lang);

const pageTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image, Astro.site ?? SITE.url).href;

const logical = logicalPath(Astro.url.pathname);
const enHref = new URL(localizePath(logical, 'en'), Astro.site ?? SITE.url).href;
const amHref = new URL(localizePath(logical, 'am'), Astro.site ?? SITE.url).href;

const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC;
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN;

const socialUrls = Object.values(SITE.social).filter(Boolean);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  telephone: SITE.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.line1,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  sameAs: socialUrls,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="am" href={amHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0e6e6e" />
    <link rel="alternate" type="application/rss+xml" title="FIKRA news" href="/rss.xml" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <!-- Open Graph / social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {analyticsSrc && (
      <script
        is:inline
        defer
        data-domain={analyticsDomain}
        src={analyticsSrc}
      ></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton />
    <BackToTop />
  </body>
</html>
