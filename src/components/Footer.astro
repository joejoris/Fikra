---
import Logo from './Logo.astro';
import NewsletterForm from './NewsletterForm.astro';
import { SITE, FOOTER_LINKS, SOCIAL_LABELS } from '../lib/site';

const year = new Date().getFullYear();
const socialEntries = Object.entries(SITE.social).filter(([, url]) => url);
const columns = [
  { heading: 'Organisation', links: FOOTER_LINKS.organisation },
  { heading: 'Get involved', links: FOOTER_LINKS.engage },
  { heading: 'More', links: FOOTER_LINKS.legal },
];
---

<footer class="mt-8 bg-gradient-to-b from-primary-dark to-[#063030] text-white">
  <div aria-hidden="true" class="h-1 w-full bg-gradient-to-r from-accent via-accent/60 to-accent"></div>
  <div class="mx-auto w-full max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div>
        <Logo wordmarkClass="text-white" />
        <p class="mt-4 max-w-xs text-sm text-white/70">{SITE.description}</p>
        <p class="mt-3 text-sm">
          <a class="text-accent hover:text-white" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </div>

      {
        columns.map((col) => (
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-widest text-white/90">{col.heading}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {col.links.map((link) => (
                <li>
                  <a class="text-white/70 transition-colors hover:text-white" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      socialEntries.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-4">
          {socialEntries.map(([key, url]) => (
            <a
              class="text-sm font-medium text-white/70 transition-colors hover:text-white"
              href={url}
              rel="noopener noreferrer"
              target="_blank"
            >
              {SOCIAL_LABELS[key] ?? key}
            </a>
          ))}
        </div>
      )
    }

    <div class="mt-10 rounded-2xl bg-surface p-6 text-ink shadow-[0_18px_40px_-20px_rgba(0,0,0,0.5)] sm:p-8">
      <NewsletterForm layout="wide" />
    </div>

    <div class="mt-10 border-t border-white/15 pt-6 text-xs text-white/60">
      <p>© {year} {SITE.name}.</p>
    </div>
  </div>
</footer>
