---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'accent' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  disabled?: boolean;
  ariaLabel?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  class: className = '',
  disabled = false,
  ariaLabel,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:translate-y-0';

const variants: Record<string, string> = {
  primary:
    'bg-gradient-to-r from-primary to-primary-dark text-white shadow-[0_10px_24px_-10px_rgba(14,110,110,0.8)] hover:shadow-[0_16px_30px_-10px_rgba(14,110,110,0.9)]',
  accent:
    'bg-gradient-to-r from-accent to-accent-dark text-ink shadow-[0_10px_24px_-10px_rgba(228,161,60,0.9)] hover:shadow-[0_16px_30px_-10px_rgba(228,161,60,1)]',
  outline: 'border border-primary text-primary hover:bg-primary-soft',
  ghost: 'text-primary hover:bg-primary-soft',
};

const sizes: Record<string, string> = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-4 py-2.5 text-sm',
  lg: 'px-6 py-3 text-base',
};

const classes = [base, variants[variant], sizes[size], className].join(' ');

const Tag = href && !disabled ? 'a' : 'button';
---

<Tag
  class={classes}
  {...href && !disabled ? { href } : { type, disabled }}
  aria-label={ariaLabel}
>
  <slot />
</Tag>
