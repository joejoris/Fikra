---
import Logo from './Logo.astro';
import { NAV_LINKS } from '../lib/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header
  class="sticky top-0 z-40 border-b border-border/80 bg-bg/85 shadow-[0_1px_0_rgba(11,31,51,0.04),0_10px_30px_-18px_rgba(11,31,51,0.35)] backdrop-blur-md"
>
  <!-- Accent gradient strip -->
  <div class="h-1 w-full bg-gradient-to-r from-primary via-accent to-primary"></div>

  <div
    class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8"
  >
    <a
      href="/"
      aria-label="FIKRA — home"
      class="group inline-flex shrink-0 items-center transition-transform duration-200 hover:scale-[1.03]"
    >
      <Logo />
    </a>

    <!-- Desktop navigation -->
    <nav
      class="hidden items-center gap-0.5 rounded-full border border-border/70 bg-surface/80 p-1 shadow-[var(--shadow-card)] md:flex"
      aria-label="Primary"
    >
      {
        NAV_LINKS.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'relative rounded-full px-3.5 py-2 text-sm font-medium transition-all duration-200',
                active
                  ? 'bg-primary text-white shadow-[0_6px_16px_-6px_rgba(14,110,110,0.75)]'
                  : 'text-ink-soft hover:-translate-y-0.5 hover:bg-primary-soft hover:text-primary',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Desktop actions -->
    <div class="hidden items-center gap-1.5 md:flex">
      <a
        href="/contact"
        class="rounded-full px-3.5 py-2 text-sm font-semibold text-ink-soft transition-colors hover:bg-primary-soft hover:text-primary"
      >
        Contact
      </a>
      <a
        href="/donate"
        class="group relative inline-flex items-center gap-1.5 overflow-hidden rounded-full bg-gradient-to-r from-accent to-accent-dark px-4 py-2 text-sm font-bold text-ink shadow-[0_8px_20px_-8px_rgba(228,161,60,0.9)] ring-1 ring-accent-dark/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_12px_26px_-8px_rgba(228,161,60,1)]"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="transition-transform duration-200 group-hover:scale-125"
        >
          <path
            d="M12 21s-7-4.35-9.5-8.5C.8 9.6 2.3 6 6 6c2 0 3.2 1.2 4 2.3.8-1.1 2-2.3 4-2.3 3.7 0 5.2 3.6 3.5 6.5C19 16.65 12 21 12 21Z"
            fill="currentColor"></path>
        </svg>
        <span class="relative">Donate</span>
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/50 to-transparent transition-transform duration-700 group-hover:translate-x-full"
        ></span>
      </a>
    </div>

    <!-- Mobile menu -->
    <details class="relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-border bg-surface px-3.5 py-2 text-sm font-semibold text-ink shadow-[var(--shadow-card)] transition-colors hover:border-primary/40 hover:text-primary [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">Menu</span>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        Menu
      </summary>
      <div
        class="absolute right-0 mt-3 w-64 overflow-hidden rounded-2xl border border-border bg-surface p-2 shadow-[0_18px_40px_-18px_rgba(11,31,51,0.5)]"
      >
        <div class="mb-1 h-1 w-full rounded-full bg-gradient-to-r from-primary via-accent to-primary"></div>
        <nav class="flex flex-col" aria-label="Mobile">
          {
            NAV_LINKS.map((link) => {
              const active = isActive(link.href);
              return (
                <a
                  href={link.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'rounded-xl px-3 py-2.5 text-sm font-medium transition-colors',
                    active
                      ? 'bg-primary text-white'
                      : 'text-ink-soft hover:bg-primary-soft hover:text-primary',
                  ]}
                >
                  {link.label}
                </a>
              );
            })
          }
          <a
            href="/team"
            class="rounded-xl px-3 py-2.5 text-sm font-medium text-ink-soft transition-colors hover:bg-primary-soft hover:text-primary"
          >
            Team
          </a>
          <a
            href="/contact"
            class="rounded-xl px-3 py-2.5 text-sm font-medium text-ink-soft transition-colors hover:bg-primary-soft hover:text-primary"
          >
            Contact
          </a>
        </nav>
        <div class="mt-1 border-t border-border p-2 pt-3">
          <a
            href="/donate"
            class="flex w-full items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-accent to-accent-dark px-4 py-2.5 text-sm font-bold text-ink shadow-[0_8px_20px_-8px_rgba(228,161,60,0.9)] transition-transform hover:-translate-y-0.5"
          >
            Donate
          </a>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  // The mobile menu is a native <details>. Close it when a link is chosen, when
  // the visitor taps outside it, or with Escape — otherwise it can stay open.
  const menu = document.querySelector<HTMLDetailsElement>('header details');
  if (menu) {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.open = false;
    });
  }
</script>
