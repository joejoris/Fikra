---
import Logo from './Logo.astro';
import Button from './Button.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { NAV, useTranslations, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const nav = NAV.map((item) => ({ href: localizePath(item.href, lang), label: t(item.key) }));
const contactHref = localizePath('/contact', lang);
const donateHref = localizePath('/donate', lang);
const homeHref = localizePath('/', lang);
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur">
  <div
    class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8"
  >
    <a href={homeHref} aria-label={t('nav.home')}>
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        nav.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-ink-soft transition-colors hover:bg-primary-soft hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <LanguageSwitcher lang={lang} />
      <Button href={contactHref} variant="ghost" size="sm">{t('nav.contact')}</Button>
      <Button href={donateHref} variant="accent" size="sm">{t('nav.donate')}</Button>
    </div>

    <details class="relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-border bg-surface px-3 py-2 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">{t('nav.menu')}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        {t('nav.menu')}
      </summary>
      <div
        class="absolute right-0 mt-2 w-60 rounded-xl border border-border bg-surface p-2 shadow-lg"
      >
        <nav class="flex flex-col" aria-label="Mobile">
          {
            nav.map((link) => (
              <a
                href={link.href}
                class="rounded-md px-3 py-2.5 text-sm font-medium text-ink-soft hover:bg-primary-soft hover:text-primary"
              >
                {link.label}
              </a>
            ))
          }
          <a
            href={localizePath('/team', lang)}
            class="rounded-md px-3 py-2.5 text-sm font-medium text-ink-soft hover:bg-primary-soft hover:text-primary"
          >
            {t('nav.team')}
          </a>
          <a
            href={contactHref}
            class="rounded-md px-3 py-2.5 text-sm font-medium text-ink-soft hover:bg-primary-soft hover:text-primary"
          >
            {t('nav.contact')}
          </a>
        </nav>
        <div class="border-t border-border p-2">
          <LanguageSwitcher lang={lang} variant="block" />
        </div>
        <div class="p-2 pt-0">
          <Button href={donateHref} variant="accent" size="md" class="w-full">
            {t('nav.donate')}
          </Button>
        </div>
      </div>
    </details>
  </div>
</header>
