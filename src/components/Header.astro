---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { NAV_LINKS } from '../lib/site';
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur">
  <div
    class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8"
  >
    <a href="/" aria-label="FIKRA — home">
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-ink-soft transition-colors hover:bg-primary-soft hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <Button href="/contact" variant="ghost" size="sm">Contact</Button>
      <Button href="/donate" variant="accent" size="sm">Donate</Button>
    </div>

    <details class="relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-border bg-surface px-3 py-2 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden"
      >
        <span class="sr-only">Menu</span>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        Menu
      </summary>
      <div
        class="absolute right-0 mt-2 w-60 rounded-xl border border-border bg-surface p-2 shadow-lg"
      >
        <nav class="flex flex-col" aria-label="Mobile">
          {
            NAV_LINKS.map((link) => (
              <a
                href={link.href}
                class="rounded-md px-3 py-2.5 text-sm font-medium text-ink-soft hover:bg-primary-soft hover:text-primary"
              >
                {link.label}
              </a>
            ))
          }
          <a
            href="/team"
            class="rounded-md px-3 py-2.5 text-sm font-medium text-ink-soft hover:bg-primary-soft hover:text-primary"
          >
            Team
          </a>
          <a
            href="/contact"
            class="rounded-md px-3 py-2.5 text-sm font-medium text-ink-soft hover:bg-primary-soft hover:text-primary"
          >
            Contact
          </a>
        </nav>
        <div class="p-2">
          <Button href="/donate" variant="accent" size="md" class="w-full">
            Donate
          </Button>
        </div>
      </div>
    </details>
  </div>
</header>
