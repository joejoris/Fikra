---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, intro, align = 'left' } = Astro.props;
const alignment = align === 'center' ? 'text-center mx-auto' : '';
---

<div class:list={['max-w-2xl', alignment]}>
  {
    eyebrow && (
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary-soft/70 px-3 py-1 text-xs font-bold uppercase tracking-widest text-primary">
        <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        {eyebrow}
      </p>
    )
  }
  <h1 class="text-3xl font-bold sm:text-4xl md:text-5xl">{title}</h1>
  {intro && <p class="mt-4 text-lg text-ink-soft">{intro}</p>}
</div>
