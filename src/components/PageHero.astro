---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, intro, align = 'left' } = Astro.props;
const alignment = align === 'center' ? 'text-center mx-auto' : '';
---

<div class:list={['max-w-2xl', alignment]}>
  {
    eyebrow && (
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary">
        {eyebrow}
      </p>
    )
  }
  <h1 class="text-3xl font-bold sm:text-4xl md:text-5xl">{title}</h1>
  {intro && <p class="mt-4 text-lg text-ink-soft">{intro}</p>}
</div>
