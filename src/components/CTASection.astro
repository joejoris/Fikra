---
import Button from './Button.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ready to build something?',
  text = 'Whether you have an idea, want to mentor, or want to fund the next enterprise — there is a place for you at FIKRA.',
} = Astro.props;
---

<section class="px-5 py-4 sm:px-8">
  <div
    data-reveal
    class="relative mx-auto w-full max-w-6xl overflow-hidden rounded-3xl bg-gradient-to-br from-primary-dark via-primary to-primary-dark px-6 py-12 shadow-[0_24px_50px_-24px_rgba(10,79,79,0.7)] sm:px-12"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -right-20 -top-24 h-72 w-72 rounded-full bg-accent/25 blur-3xl"></div>
      <div class="absolute -bottom-28 -left-16 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>
    </div>
    <div
      class="relative flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="max-w-xl">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">{title}</h2>
        <p class="mt-3 text-white/85">{text}</p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <Button href="/get-involved" variant="accent" size="lg">Get involved</Button>
        <Button
          href="/donate"
          variant="outline"
          size="lg"
          class="border-white/60 text-white hover:bg-white/10 hover:text-white"
        >
          Donate
        </Button>
      </div>
    </div>
  </div>
</section>
