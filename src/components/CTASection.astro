---
import Button from './Button.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ready to build something?',
  text = 'Whether you have an idea, want to mentor, or want to fund the next enterprise — there is a place for you at FIKRA.',
} = Astro.props;
---

<section class="border-y border-border bg-primary text-white">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col items-start gap-6 px-5 py-14 sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <div class="max-w-xl">
      <h2 class="text-2xl font-bold sm:text-3xl">{title}</h2>
      <p class="mt-3 text-white/85">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <Button href="/get-involved" variant="accent" size="lg">Get involved</Button>
      <Button
        href="/donate"
        variant="outline"
        size="lg"
        class="border-white text-white hover:bg-white/10"
      >
        Donate
      </Button>
    </div>
  </div>
</section>
