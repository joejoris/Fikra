---
interface Props {
  class?: string;
  href?: string;
}

const { class: className = '', href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['block', href && 'group', className]}
  {...href ? { href } : {}}
>
  <div
    class="h-full rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition group-hover:border-primary/40 group-hover:shadow-md"
  >
    <slot />
  </div>
</Tag>
