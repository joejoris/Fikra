---
// Comments + likes for a single page. Pass a stable `page` key (e.g. the news
// slug). Guests post with a name + email; signed-in members post as themselves.
interface Props {
  page: string;
  heading?: string;
}
const { page, heading = 'Comments' } = Astro.props;
---

<section
  class="rounded-[var(--radius-card)] border border-border bg-bg/40 p-6"
  data-comments
  data-page={page}
>
  <div class="flex items-center gap-3">
    <h2 class="text-xl font-bold text-ink">{heading}</h2>
    <span data-comment-count class="text-sm text-muted"></span>
  </div>

  <form data-comment-form class="mt-5 space-y-3" novalidate>
    <div data-guest-fields class="grid gap-3 sm:grid-cols-2">
      <label class="text-sm font-semibold text-ink">
        Your name
        <input
          type="text"
          name="name"
          autocomplete="name"
          class="mt-1 block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
        />
      </label>
      <label class="text-sm font-semibold text-ink">
        Your email <span class="font-normal text-muted">(not shown)</span>
        <input
          type="email"
          name="email"
          autocomplete="email"
          class="mt-1 block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
        />
      </label>
    </div>
    <label class="block text-sm font-semibold text-ink">
      Comment
      <textarea
        name="body"
        rows="3"
        required
        placeholder="Share a thought…"
        class="mt-1 block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
      ></textarea>
    </label>
    <input type="hidden" name="_loadedAt" data-loaded-at value="" />
    <div class="flex items-center gap-3">
      <button
        type="submit"
        data-comment-submit
        class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Post comment
      </button>
      <p data-comment-status class="text-sm text-muted" aria-live="polite"></p>
    </div>
  </form>

  <div data-comment-list class="mt-6 space-y-4"></div>
</section>

<script>
  import { initComments } from '../scripts/community';
  initComments();
</script>
