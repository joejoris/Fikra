---
// Floating site-wide chat. Included by BaseLayout on every page except
// /community (which shows the full inline room). Behaviour lives in
// src/scripts/community.ts — one shared room, instant updates, chime and
// browser notification for background messages.
---

<div class="fixed bottom-5 right-5 z-50 flex flex-col items-end print:hidden" data-chat-widget>
  <div
    data-chat-panel
    hidden
    class="mb-3 w-[22rem] max-w-[calc(100vw-2.5rem)] overflow-hidden rounded-2xl border border-border bg-surface shadow-2xl"
  >
    <div class="flex items-center justify-between gap-2 border-b border-border bg-bg/60 px-4 py-3">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-green-500" aria-hidden="true"></span>
        <strong class="text-sm text-ink">Community chat</strong>
      </div>
      <button
        type="button"
        data-chat-close
        aria-label="Close chat"
        class="rounded-full px-2 text-lg leading-none text-muted hover:text-ink"
      >
        ×
      </button>
    </div>

    <div class="p-4" data-chat>
      <div
        data-chat-list
        class="max-h-64 space-y-3 overflow-y-auto rounded-lg border border-border bg-bg p-3"
        aria-live="polite"
      >
        <p class="text-sm text-muted">Loading…</p>
      </div>

      <form data-chat-form class="mt-3 space-y-2" novalidate>
        <input
          type="text"
          name="body"
          maxlength="2000"
          required
          placeholder="Type your message…"
          class="block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
        />
        <div data-guest-fields class="grid gap-2 sm:grid-cols-2">
          <input
            type="text"
            name="name"
            autocomplete="name"
            placeholder="Your name"
            class="block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
          />
          <input
            type="email"
            name="email"
            autocomplete="email"
            placeholder="Email (private)"
            class="block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
          />
        </div>
        <div class="flex items-center gap-2">
          <button
            type="submit"
            class="rounded-full bg-primary px-4 py-1.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
          >
            Send
          </button>
          <p data-chat-status class="text-sm text-red-600" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>

  <button
    type="button"
    data-chat-toggle
    aria-label="Open community chat"
    class="relative flex items-center gap-2 rounded-full bg-primary px-5 py-3 text-sm font-semibold text-white shadow-lg transition-transform hover:scale-105"
  >
    <span aria-hidden="true">💬</span> Chat
    <span
      data-chat-badge
      hidden
      class="absolute -right-1 -top-1 min-w-[1.25rem] rounded-full bg-red-600 px-1 text-center text-xs font-bold leading-5 text-white"
    ></span>
  </button>
</div>

<script>
  import { initChat } from '../scripts/community';
  initChat();
</script>
