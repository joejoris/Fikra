---
// Discussion board (topics + replies). New topics and replies wait for
// approval in /inbox/community before they appear on the site.
---

<div data-board>
  <form
    data-topic-form
    class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)]"
    novalidate
  >
    <h2 class="text-xl font-bold text-ink">Start a discussion</h2>
    <p class="mt-1 text-sm text-ink-soft">
      Ask a question, share an opportunity, or introduce yourself.
    </p>
    <div class="mt-5 space-y-3">
      <label class="block text-sm font-semibold text-ink">
        Title
        <input
          type="text"
          name="title"
          maxlength="140"
          required
          class="mt-1 block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
        />
      </label>
      <label class="block text-sm font-semibold text-ink">
        Message
        <textarea
          name="body"
          rows="3"
          required
          class="mt-1 block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
        ></textarea>
      </label>
      <div data-guest-fields class="grid gap-3 sm:grid-cols-2">
        <label class="text-sm font-semibold text-ink">
          Your name
          <input
            type="text"
            name="name"
            autocomplete="name"
            class="mt-1 block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
          />
        </label>
        <label class="text-sm font-semibold text-ink">
          Your email <span class="font-normal text-muted">(not shown)</span>
          <input
            type="email"
            name="email"
            autocomplete="email"
            class="mt-1 block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
          />
        </label>
      </div>
    </div>
    <div class="mt-4 flex items-center gap-3">
      <button
        type="submit"
        data-topic-submit
        class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Post
      </button>
      <p data-topic-status class="text-sm text-muted" aria-live="polite"></p>
    </div>
  </form>

  <div data-topic-list class="mt-6 space-y-4"></div>
</div>

<script>
  import { initBoard } from '../scripts/community';
  initBoard();
</script>
