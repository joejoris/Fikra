---
interface Props {
  id?: string;
  class?: string;
  tone?: 'default' | 'soft' | 'primary' | 'white';
  as?: 'section' | 'div';
}

const {
  id,
  class: className = '',
  tone = 'default',
  as: Tag = 'section',
} = Astro.props;

const tones: Record<string, string> = {
  default: '',
  soft: 'bg-primary-soft',
  primary: 'bg-primary text-white',
  white: 'bg-surface',
};

const classes = ['py-14 sm:py-20', tones[tone], className].join(' ');
---

<Tag id={id} class={classes}>
  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
    <slot />
  </div>
</Tag>
