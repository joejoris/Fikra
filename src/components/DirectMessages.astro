---
// Private direct messages. Members only — guests see a prompt to sign in
// (the account panel is just above on /community). See src/scripts/community.ts.
---

<section
  class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)]"
  data-dms
>
  <div class="flex items-center gap-2">
    <h2 class="text-xl font-bold text-ink">Direct messages</h2>
  </div>
  <p class="mt-1 text-sm text-ink-soft" data-dm-signedout>
    Private messages are for members. Sign in above to start a one-to-one conversation.
  </p>

  <div data-dm-app hidden>
    <div class="mt-4 grid gap-6 lg:grid-cols-[16rem_1fr]">
      <aside class="space-y-3">
        <input
          type="search"
          data-dm-search
          placeholder="Find someone by name or email…"
          class="block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
        />
        <div data-dm-results class="space-y-1"></div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted">Conversations</p>
          <div data-dm-conversations class="mt-2 space-y-1"></div>
        </div>
      </aside>

      <section class="min-h-[16rem] rounded-lg border border-border bg-bg p-4">
        <div data-dm-head class="text-sm font-semibold text-ink">Select a conversation</div>
        <div data-dm-messages class="mt-3 max-h-72 space-y-3 overflow-y-auto" aria-live="polite"></div>
        <form data-dm-form class="mt-3 hidden space-y-2" novalidate>
          <textarea
            name="body"
            rows="2"
            maxlength="2000"
            required
            placeholder="Write a private message…"
            class="block w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"></textarea>
          <div class="flex items-center gap-3">
            <button
              type="submit"
              class="rounded-full bg-primary px-4 py-1.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
            >
              Send
            </button>
            <p data-dm-status class="text-sm text-red-600" aria-live="polite"></p>
          </div>
        </form>
      </section>
    </div>
  </div>
</section>

<script>
  import { initDms } from '../scripts/community';
  initDms();
</script>
