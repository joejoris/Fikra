---
interface Props {
  class?: string;
  size?: number;
  showWordmark?: boolean;
  wordmarkClass?: string;
}

const { class: className = '', size = 32, showWordmark = true, wordmarkClass = 'text-ink' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 48 48"
    role="img"
    aria-label="FIKRA"
    class="shrink-0"
  >
    <rect width="48" height="48" rx="12" fill="#0e6e6e"></rect>
    <!-- Rising idea / growth mark -->
    <circle cx="24" cy="18" r="5" fill="#e4a13c"></circle>
    <path
      d="M23 39V26m0 0-7-7m7 7 7-7"
      fill="none"
      stroke="#ffffff"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  {
    showWordmark && (
      <span class:list={['font-bold tracking-tight text-lg', wordmarkClass]}>FIKRA</span>
    )
  }
</span>
