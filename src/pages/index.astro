---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Stat from '../components/Stat.astro';
import ProgramCard from '../components/ProgramCard.astro';
import NewsCard from '../components/NewsCard.astro';
import CTASection from '../components/CTASection.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { STATS } from '../lib/site';

const programs = (await getCollection('programs')).sort(
  (a, b) => a.data.order - b.data.order,
);

const news = (
  await getCollection('news', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  )
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const stories = (
  await getCollection('impact', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  )
).sort((a, b) => a.data.order - b.data.order);

const team = (await getCollection('team')).sort(
  (a, b) => a.data.order - b.data.order,
);

const initials = (name: string) =>
  name
    .replace(/\[.*?\]/g, '')
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0] ?? '')
    .join('')
    .toUpperCase() || '–';
---

<BaseLayout title="FIKRA — from idea to enterprise">
  <!-- Hero -->
  <div class="border-b border-border bg-surface">
    <div class="mx-auto grid w-full max-w-6xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-2 lg:items-center lg:py-24">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary">
          Youth entrepreneurship
        </p>
        <h1 class="text-4xl font-bold sm:text-5xl lg:text-6xl">
          From idea to enterprise.
        </h1>
        <p class="mt-5 max-w-xl text-lg text-ink-soft">
          FIKRA supports young people to turn ideas into sustainable businesses —
          through training, mentorship and access to real opportunity.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/get-involved" variant="primary" size="lg">
            Get involved
          </Button>
          <Button href="/programs" variant="outline" size="lg">
            Explore programs
          </Button>
        </div>
      </div>

      <div class="rounded-[var(--radius-card)] border border-border bg-bg p-8 shadow-[var(--shadow-card)]">
        <h2 class="text-lg font-bold">How we work</h2>
        <ol class="mt-5 space-y-5">
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary font-semibold text-white">1</span>
            <span><strong class="text-ink">Test the idea.</strong> <span class="text-ink-soft">Learn who the customer is and whether the problem is real.</span></span>
          </li>
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary font-semibold text-white">2</span>
            <span><strong class="text-ink">Build the business.</strong> <span class="text-ink-soft">Mentorship, workspace and small grants to reach first revenue.</span></span>
          </li>
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary font-semibold text-white">3</span>
            <span><strong class="text-ink">Grow with peers.</strong> <span class="text-ink-soft">Ongoing circles keep founders learning and accountable.</span></span>
          </li>
        </ol>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <Section tone="soft">
    <p class="mb-8 text-sm font-semibold uppercase tracking-widest text-primary">
      Our impact so far
    </p>
    <div class="grid gap-8 sm:grid-cols-3">
      {STATS.map((stat) => <Stat value={stat.value} label={stat.label} />)}
    </div>
    <p class="mt-8 text-sm text-muted">
      Figures to be confirmed with FIKRA before launch.
    </p>
  </Section>

  <!-- Programs -->
  <Section>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold sm:text-3xl">Programs</h2>
        <p class="mt-3 text-ink-soft">
          A path for every stage — from your first idea to a business that is
          already trading.
        </p>
      </div>
      <Button href="/programs" variant="ghost">See all programs</Button>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {programs.map((program) => <ProgramCard program={program} />)}
    </div>
  </Section>

  <!-- About teaser -->
  <Section tone="white">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">Why FIKRA exists</h2>
        <p class="mt-4 text-ink-soft">
          Talent is everywhere; opportunity is not. FIKRA exists to close that
          gap for young people who have the drive to build something but not
          always the network, the capital or the know-how to get started.
        </p>
        <div class="mt-6">
          <Button href="/about" variant="ghost">More about us</Button>
        </div>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          [
            ['Practical', 'We learn by doing, not by lecturing.'],
            ['Local', 'Built with and for the communities we serve.'],
            ['Honest', 'We report what works and what does not.'],
            ['Lasting', 'We aim for enterprises that outlive our support.'],
          ].map(([title, text]) => (
            <li class="rounded-[var(--radius-card)] border border-border p-5">
              <h3 class="font-bold text-ink">{title}</h3>
              <p class="mt-1 text-sm text-ink-soft">{text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Impact / stories -->
  <Section tone="soft">
    <h2 class="text-2xl font-bold sm:text-3xl">Stories</h2>
    {
      stories.length > 0 ? (
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {stories.slice(0, 2).map((story) => (
            <article class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)]">
              <h3 class="text-lg font-bold text-ink">{story.data.title}</h3>
              <p class="mt-2 text-sm text-ink-soft">{story.data.summary}</p>
              {story.data.person && (
                <p class="mt-4 text-sm font-medium text-muted">
                  {story.data.person}
                  {story.data.location && ` · ${story.data.location}`}
                </p>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="mt-6 max-w-2xl text-ink-soft">
          We are preparing to share the stories of the founders we work with.
          Check back soon, or
          <a class="text-primary underline" href="/contact">get in touch</a> to hear more.
        </p>
      )
    }
    <div class="mt-8">
      <Button href="/impact" variant="ghost">See our impact</Button>
    </div>
  </Section>

  <!-- Team -->
  <Section>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold sm:text-3xl">The team</h2>
        <p class="mt-3 text-ink-soft">
          A small team, working closely with mentors and partners to support
          every founder we take on.
        </p>
      </div>
      <Button href="/team" variant="ghost">Meet the team</Button>
    </div>
    <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        team.map((member) => (
          <li class="flex items-center gap-4">
            <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-primary-soft text-xl font-bold text-primary">
              {initials(member.data.name)}
            </span>
            <span>
              <span class="block font-bold text-ink">{member.data.name}</span>
              <span class="block text-sm text-ink-soft">{member.data.role}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- News -->
  {
    news.length > 0 && (
      <Section>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="text-2xl font-bold sm:text-3xl">News</h2>
          <Button href="/news" variant="ghost">All news</Button>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {news.map((post) => <NewsCard post={post} />)}
        </div>
      </Section>
    )
  }

  <!-- Newsletter -->
  <Section tone="white">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold sm:text-3xl">Be first to hear</h2>
      <p class="mt-3 text-ink-soft">
        Join the FIKRA mailing list for new cohorts, events and opportunities —
        a few emails a year, nothing more.
      </p>
      <div class="mt-8 text-left">
        <NewsletterForm />
      </div>
    </div>
  </Section>

  <CTASection />
</BaseLayout>
