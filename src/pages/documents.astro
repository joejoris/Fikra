---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';

const CATEGORY_ORDER = ['Governance', 'Reports', 'Policies', 'Other'] as const;

const docs = (
  await getCollection('documents', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  )
).sort((a, b) => a.data.order - b.data.order);

const grouped = CATEGORY_ORDER.map((category) => ({
  category,
  items: docs.filter((doc) => doc.data.category === category),
})).filter((group) => group.items.length > 0);

const fmtDate = (date?: Date) =>
  date
    ? date.toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      })
    : undefined;
---

<BaseLayout
  title="Documents & reports"
  description="FIKRA's governance documents, policies and annual reports available to download."
>
  <Section>
    <PageHero
      eyebrow="Transparency"
      title="Documents and reports"
      intro="Our governing documents, policies and reports. We publish these so that anyone can see how FIKRA is run."
    />
  </Section>

  <Section tone="white">
    {
      grouped.length > 0 ? (
        <div class="space-y-12">
          {grouped.map((group) => (
            <div>
              <h2 class="text-xl font-bold text-ink">{group.category}</h2>
              <ul class="mt-5 divide-y divide-border">
                {group.items.map((doc) => (
                  <li class="flex flex-col gap-3 py-5 sm:flex-row sm:items-start sm:justify-between">
                    <div class="max-w-2xl">
                      <h3 class="font-semibold text-ink">{doc.data.title}</h3>
                      <p class="mt-1 text-sm text-ink-soft">{doc.data.description}</p>
                      <p class="mt-2 text-xs uppercase tracking-wide text-muted">
                        {doc.data.fileType}
                        {doc.data.size && ` · ${doc.data.size}`}
                        {doc.data.date && ` · ${fmtDate(doc.data.date) as string}`}
                      </p>
                    </div>
                    <a
                      class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-primary px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-soft"
                      href={doc.data.file}
                      download
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                          d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                      </svg>
                      Download
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ) : (
        <div class="max-w-2xl">
          <p class="text-ink-soft">
            Our governance documents and reports are being prepared for publication.
            If you need a copy of anything now,
            <a class="text-primary underline" href="/contact">contact us</a> and we will send it.
          </p>
        </div>
      )
    }
  </Section>

  <Section tone="soft">
    <h2 class="text-2xl font-bold">Need something not listed?</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      We are happy to share more about how FIKRA is governed and funded.
      Give us a call or send a message.
    </p>
    <div class="mt-6">
      <a class="font-semibold text-primary underline" href="/contact">Contact us →</a>
    </div>
  </Section>

  <CTASection />
</BaseLayout>
