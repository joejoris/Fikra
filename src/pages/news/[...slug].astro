---
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import CTASection from '../../components/CTASection.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Per-post OG image is generated before the build (see `npm run og`);
// fall back to the default share image when the generator did not run.
const generatedOg = `/og/news-${post.id.replace(/\//g, '-')}.png`;
const ogImage = post.data.cover
  ?? (existsSync(join(process.cwd(), 'public', generatedOg)) ? generatedOg : undefined);

const date = post.data.pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={post.data.title} description={post.data.description} ogType="article" image={ogImage}>
  <Section>
    <div class="mx-auto max-w-2xl">
      <p class="mb-4">
        <a class="text-sm font-medium text-primary hover:underline" href="/news">
          ← All news
        </a>
      </p>
      <h1 class="text-3xl font-bold sm:text-4xl">{post.data.title}</h1>
      <p class="mt-3 text-sm text-muted">
        <time datetime={post.data.pubDate.toISOString()}>{date}</time> · {post.data.author}
      </p>
      <div class="prose mt-8">
        <Content />
      </div>
    </div>
  </Section>

  <CTASection />
</BaseLayout>
