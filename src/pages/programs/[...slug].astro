---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Form from '../../components/Form.astro';
import CTASection from '../../components/CTASection.astro';

export async function getStaticPaths() {
  const programs = await getCollection('programs');
  return programs.map((program) => ({
    params: { slug: program.id },
    props: { program },
  }));
}

const { program } = Astro.props;
const { Content } = await render(program);
const { title, summary, audience, status, duration, location, tags } = program.data;

const statusLabels: Record<string, string> = {
  open: 'Applications open',
  'coming-soon': 'Coming soon',
  closed: 'Closed',
};
---

<BaseLayout title={title} description={summary}>
  <Section>
    <p class="mb-4">
      <a class="text-sm font-medium text-primary hover:underline" href="/programs">
        ← All programs
      </a>
    </p>
    <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr]">
      <div>
        <span class="inline-block rounded-full bg-primary-soft px-3 py-1 text-xs font-semibold text-primary">
          {statusLabels[status]}
        </span>
        <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{title}</h1>
        <p class="mt-4 text-lg text-ink-soft">{summary}</p>

        <div class="prose mt-10">
          <Content />
        </div>
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">
            At a glance
          </h2>
          <dl class="mt-4 space-y-3 text-sm">
            <div>
              <dt class="font-semibold text-ink">Who it is for</dt>
              <dd class="text-ink-soft">{audience}</dd>
            </div>
            {duration && (
              <div>
                <dt class="font-semibold text-ink">Duration</dt>
                <dd class="text-ink-soft">{duration}</dd>
              </div>
            )}
            {location && (
              <div>
                <dt class="font-semibold text-ink">Where</dt>
                <dd class="text-ink-soft">{location}</dd>
              </div>
            )}
            {
              tags.length > 0 && (
                <div>
                  <dt class="font-semibold text-ink">Focus</dt>
                  <dd class="mt-1 flex flex-wrap gap-2">
                    {tags.map((tag) => (
                      <span class="rounded-full bg-bg px-2.5 py-1 text-xs text-ink-soft">{tag}</span>
                    ))}
                  </dd>
                </div>
              )
            }
          </dl>
        </div>

        {
          status === 'open' && (
            <div class="mt-6 rounded-[var(--radius-card)] border border-border bg-surface p-6">
              <Form
                name={`program-${program.id}`}
                heading="Register your interest"
                description="We will contact you with next steps and dates."
                submitLabel="Register interest"
                presetProgram={title}
                showMessage
              />
            </div>
          )
        }

        {
          status !== 'open' && (
            <div class="mt-6 rounded-[var(--radius-card)] border border-border bg-primary-soft p-6 text-sm text-ink-soft">
              Applications for this programme are not open right now.
              <a class="font-semibold text-primary underline" href="/contact">Contact us</a>
              to be told when they are.
            </div>
          )
        }
      </aside>
    </div>
  </Section>

  <CTASection />
</BaseLayout>
