---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';

const team = (await getCollection('team')).sort(
  (a, b) => a.data.order - b.data.order,
);

const initials = (name: string) =>
  name
    .replace(/\[.*?\]/g, '')
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0] ?? '')
    .join('')
    .toUpperCase() || '–';
---

<BaseLayout
  title="Team"
  description="The people behind FIKRA."
>
  <Section>
    <PageHero
      eyebrow="Team"
      title="The people behind FIKRA"
      intro="A small team, working closely with mentors and partners to support every founder we take on."
    />
  </Section>

  <Section tone="white">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        team.map((member) => (
          <article>
            {member.data.photo ? (
              <img
                class="aspect-square w-full rounded-[var(--radius-card)] object-cover"
                style={{ objectPosition: member.data.photoPosition ?? 'top' }}
                src={member.data.photo}
                alt={`Photo of ${member.data.name}`}
                loading="lazy"
              />
            ) : (
              <div class="flex aspect-square items-center justify-center rounded-[var(--radius-card)] bg-primary-soft text-3xl font-bold text-primary">
                {initials(member.data.name)}
              </div>
            )}
            <h2 class="mt-4 text-lg font-bold text-ink">{member.data.name}</h2>
            <p class="text-sm font-medium text-primary">{member.data.role}</p>
            <p class="mt-2 text-sm text-ink-soft">{member.data.bio}</p>
            {member.data.email && (
              <a class="mt-2 inline-block text-sm text-primary underline" href={`mailto:${member.data.email}`}>
                {member.data.email}
              </a>
            )}
          </article>
        ))
      }
    </div>
  </Section>

  <Section tone="soft">
    <h2 class="text-2xl font-bold">Join the team</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      We are always glad to hear from people who want to mentor, volunteer or
      partner with us.
    </p>
    <div class="mt-6">
      <a class="font-semibold text-primary underline" href="/get-involved">See ways to get involved →</a>
    </div>
  </Section>

  <CTASection />
</BaseLayout>
