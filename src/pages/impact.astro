---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import Stat from '../components/Stat.astro';
import CTASection from '../components/CTASection.astro';
import { STATS } from '../lib/site';

const stories = (
  await getCollection('impact', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  )
).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  stories.map(async (story) => ({
    story,
    Content: (await render(story)).Content,
  })),
);
---

<BaseLayout
  title="Impact"
  description="The change FIKRA's work has made for young founders and their communities."
>
  <Section>
    <PageHero
      eyebrow="Impact"
      title="What our work changes"
      intro="Numbers matter, but so do the people behind them. Here is what FIKRA's work has made possible so far."
    />
  </Section>

  <Section tone="white">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        What this means for people
      </p>
      <h2 class="mt-2 text-2xl font-bold sm:text-3xl">
        Change you can feel in daily life
      </h2>
      <p class="mt-4 text-ink-soft">
        FIKRA's work is counted in enterprises, but it is lived in people's
        lives. When a young person's idea becomes a real business, here is what
        that changes:
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md group">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary transition-transform duration-200 group-hover:scale-110">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 9 12 4 2 9l10 5 10-5Z"></path>
            <path d="M6 11.5V16c0 1.1 2.7 2.5 6 2.5s6-1.4 6-2.5v-4.5"></path>
            <path d="M22 9v5"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">Skills that stick</h3>
        <p class="mt-2 text-sm text-ink-soft">
          Training moves from the classroom into the market: planning, finance,
          sales and customer care that young people can use the day they leave —
          and every day after.
        </p>
      </div>

      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md group">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary transition-transform duration-200 group-hover:scale-110">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 21h18"></path>
            <path d="M4 17l5-5 3 3 8-8"></path>
            <path d="M14 7h7v7"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">From idea to income</h3>
        <p class="mt-2 text-sm text-ink-soft">
          With training, mentorship and access to opportunity, ideas become
          products, services and income that founders can build on — not just
          once, but season after season.
        </p>
      </div>

      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md group">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary transition-transform duration-200 group-hover:scale-110">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 21s-7-4.35-9.5-8.5C.8 9.6 2.3 6 6 6c2 0 3.2 1.2 4 2.3.8-1.1 2-2.3 4-2.3 3.7 0 5.2 3.6 3.5 6.5C19 16.65 12 21 12 21Z" fill="currentColor"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">Confidence and dignity</h3>
        <p class="mt-2 text-sm text-ink-soft">
          Earning through their own work builds self-belief and independence —
          an income a young person built for themselves, not a handout.
        </p>
      </div>

      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md group">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary transition-transform duration-200 group-hover:scale-110">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 11 9-8 9 8"></path>
            <path d="M5 10v10h14V10"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">Families and futures</h3>
        <p class="mt-2 text-sm text-ink-soft">
          A growing enterprise supports school fees, healthcare and housing —
          lifting whole households, not just the founder.
        </p>
      </div>

      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md group">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary transition-transform duration-200 group-hover:scale-110">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="8" r="3.5"></circle>
            <path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5"></path>
            <circle cx="17" cy="9" r="2.5"></circle>
            <path d="M16 14.6c2.7.3 4.6 2 5.2 4.4"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">Jobs in the community</h3>
        <p class="mt-2 text-sm text-ink-soft">
          Growing enterprises hire peers, create opportunities and keep money
          circulating in the local economy.
        </p>
      </div>

      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md group">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary transition-transform duration-200 group-hover:scale-110">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">Role models for the next generation</h3>
        <p class="mt-2 text-sm text-ink-soft">
          Every working founder shows the next cohort that enterprise is a real,
          reachable path — not a dream for someone else.
        </p>
      </div>
    </div>

    <p class="mt-8 text-sm text-muted">
      The outcomes above describe the goals of FIKRA's model. They will be
      confirmed and refined with FIKRA before launch.
    </p>
  </Section>

  <Section tone="soft">
    <div class="grid gap-8 sm:grid-cols-3">
      {STATS.map((stat) => <Stat value={stat.value} label={stat.label} />)}
    </div>
    <p class="mt-8 text-sm text-muted">
      Figures to be confirmed with FIKRA before launch.
    </p>
  </Section>

  <Section tone="white">
    <h2 class="text-2xl font-bold sm:text-3xl">Stories</h2>
    {
      rendered.length > 0 ? (
        <div class="mt-10 space-y-12">
          {rendered.map(({ story, Content }) => (
            <article class="max-w-3xl">
              <h3 class="text-xl font-bold text-ink">{story.data.title}</h3>
              <p class="mt-2 text-ink-soft">{story.data.summary}</p>
              {(story.data.person || story.data.location) && (
                <p class="mt-4 text-sm font-medium text-muted">
                  {[story.data.person, story.data.location].filter(Boolean).join(' · ')}
                </p>
              )}
              <div class="prose mt-6">
                <Content />
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="mt-6 max-w-2xl text-ink-soft">
          We are preparing to share the stories of the founders we work with.
          Check back soon, or
          <a class="text-primary underline" href="/contact">get in touch</a> to hear more.
        </p>
      )
    }
  </Section>

  <CTASection />
</BaseLayout>
