---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import StatStrip from '../components/StatStrip.astro';
import Comments from '../components/Comments.astro';
import CTASection from '../components/CTASection.astro';
import { IMPACT_STATS } from '../lib/site';

const stories = (
  await getCollection('impact', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  )
).sort((a, b) => a.data.order - b.data.order);

const testimonials = (
  await getCollection('testimonials', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  )
).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  stories.map(async (story) => ({
    story,
    Content: (await render(story)).Content,
  })),
);
---

<BaseLayout
  title="Impact"
  description="The change FIKRA's work has made for young founders and their communities."
>
  <Section>
    <PageHero
      eyebrow="Impact"
      title="What our work changes"
      intro="Numbers matter, but so do the people behind them. Here is what FIKRA's work has made possible so far."
    />
  </Section>

  {
    IMPACT_STATS.stats.length > 0 && (
      <Section tone="soft">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-primary">
            By the numbers
          </p>
          <h2 class="mt-2 text-2xl font-bold sm:text-3xl">{IMPACT_STATS.heading}</h2>
          <p class="mt-4 text-ink-soft">{IMPACT_STATS.note}</p>
        </div>
        <div class="mt-10">
          <StatStrip stats={IMPACT_STATS.stats} />
        </div>
      </Section>
    )
  }

  <Section tone="white">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        What this means for people
      </p>
      <h2 class="mt-2 text-2xl font-bold sm:text-3xl">
        Change you can feel in daily life
      </h2>
      <p class="mt-4 text-ink-soft">
        FIKRA's work is counted in enterprises, but it is lived in people's
        lives. When a young person's idea becomes a real business, here is what
        that changes:
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md group">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary transition-transform duration-200 group-hover:scale-110">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 9 12 4 2 9l10 5 10-5Z"></path>
            <path d="M6 11.5V16c0 1.1 2.7 2.5 6 2.5s6-1.4 6-2.5v-4.5"></path>
            <path d="M22 9v5"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">Skills that stick</h3>
        <p class="mt-2 text-sm text-ink-soft">
          Training moves from the classroom into the market: planning, finance,
          sales and customer care that young people can use the day they leave —
          and every day after.
        </p>
      </div>

      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md group">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary transition-transform duration-200 group-hover:scale-110">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 21h18"></path>
            <path d="M4 17l5-5 3 3 8-8"></path>
            <path d="M14 7h7v7"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">From idea to income</h3>
        <p class="mt-2 text-sm text-ink-soft">
          With training, mentorship and access to opportunity, ideas become
          products, services and income that founders can build on — not just
          once, but season after season.
        </p>
      </div>

      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md group">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary transition-transform duration-200 group-hover:scale-110">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 21s-7-4.35-9.5-8.5C.8 9.6 2.3 6 6 6c2 0 3.2 1.2 4 2.3.8-1.1 2-2.3 4-2.3 3.7 0 5.2 3.6 3.5 6.5C19 16.65 12 21 12 21Z" fill="currentColor"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">Confidence and dignity</h3>
        <p class="mt-2 text-sm text-ink-soft">
          Earning through their own work builds self-belief and independence —
          an income a young person built for themselves, not a handout.
        </p>
      </div>

      <div class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md group">
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary transition-transform duration-200 group-hover:scale-110">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">Role models for the next generation</h3>
        <p class="mt-2 text-sm text-ink-soft">
          Every working founder shows the next cohort that enterprise is a real,
          reachable path — not a dream for someone else.
        </p>
      </div>
    </div>

    <p class="mt-8 text-sm text-muted">
      The outcomes above describe the goals of FIKRA's model. They will be
      confirmed and refined with FIKRA before launch.
    </p>
  </Section>

  <!-- Our story -->
  <Section tone="soft">
    <div class="grid gap-10 lg:grid-cols-5 lg:items-center">
      <div class="lg:col-span-3">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary">
          Our story
        </p>
        <h2 class="mt-2 text-2xl font-bold sm:text-3xl">Why FIKRA exists</h2>
        <div class="prose mt-6">
          <p>
            FIKRA began with a conviction: talent is everywhere — opportunity is
            not. We kept meeting young people with the drive and the ideas to
            build something real, held back not by ability but by access. No
            network to open doors. No capital to test an idea. No one who had
            done it to show the way.
          </p>
          <p>
            So we started small — with the founders in front of us.
          </p>
          <p>
            What began as informal mentoring grew into structured programmes —
            practical training, close mentorship and real access to markets and
            funding. And that same path now carries a founder from first idea to
            established business: the enterprises they build create income, jobs
            and confidence — and prove to the next cohort that building is
            within reach.
          </p>
        </div>
      </div>

      <div
        class="rounded-[var(--radius-card)] border border-border bg-surface p-8 shadow-[var(--shadow-card)] lg:col-span-2"
      >
        <p class="text-sm font-semibold uppercase tracking-widest text-primary">
          Our belief
        </p>
        <blockquote class="mt-3 text-2xl font-bold leading-snug text-ink">
          "From idea to enterprise."
        </blockquote>
        <p class="mt-4 text-ink-soft">
          We walk with young founders until their idea is a business that can
          stand on its own — and keep walking with them as it grows.
        </p>
        <div class="mt-6 border-t border-border pt-5 text-sm text-muted">
          Training · Mentorship · Access to opportunity
        </div>
      </div>
    </div>
  </Section>

  <!-- What we do -->
  <Section>
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        What we do
      </p>
      <h2 class="mt-2 text-2xl font-bold sm:text-3xl">
        Three supports, one goal: an enterprise that lasts
      </h2>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <div class="relative rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md">
        <span
          class="absolute right-5 top-5 text-3xl font-bold text-primary-soft"
          aria-hidden="true"
        >
          01
        </span>
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">Train</h3>
        <p class="mt-2 text-sm text-ink-soft">
          Hands-on, practical learning in planning, finance, sales and customer
          care. Founders learn by doing — what works in the market beats what
          happens in a classroom.
        </p>
      </div>

      <div class="relative rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md">
        <span
          class="absolute right-5 top-5 text-3xl font-bold text-primary-soft"
          aria-hidden="true"
        >
          02
        </span>
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="8" r="3.5"></circle>
            <path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5"></path>
            <circle cx="17" cy="9" r="2.5"></circle>
            <path d="M16 14.6c2.7.3 4.6 2 5.2 4.4"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">Mentor</h3>
        <p class="mt-2 text-sm text-ink-soft">
          One-to-one mentorship and peer circles that keep founders learning,
          honest and accountable — long after the formal sessions end.
        </p>
      </div>

      <div class="relative rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)] transition hover:border-primary/40 hover:shadow-md">
        <span
          class="absolute right-5 top-5 text-3xl font-bold text-primary-soft"
          aria-hidden="true"
        >
          03
        </span>
        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-soft text-primary">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 2 11 13"></path>
            <path d="M22 2 15 22l-4-9-9-4 20-7Z"></path>
          </svg>
        </div>
        <h3 class="mt-4 text-base font-bold text-ink">Open doors</h3>
        <p class="mt-2 text-sm text-ink-soft">
          Workspace, networks, small grants and market access — the
          opportunities that are usually out of reach for young founders.
        </p>
      </div>
    </div>
  </Section>

  {
    testimonials.length > 0 && (
      <Section>
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-widest text-primary">
            In their words
          </p>
          <h2 class="mt-2 text-2xl font-bold sm:text-3xl">What people say</h2>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {testimonials.map((t) => (
            <TestimonialCard
              quote={t.data.quote}
              name={t.data.name}
              role={t.data.role}
              location={t.data.location}
            />
          ))}
        </div>
      </Section>
    )
  }

  <Section tone="white">
    <h2 class="text-2xl font-bold sm:text-3xl">Stories</h2>
    {
      rendered.length > 0 ? (
        <div class="mt-10 space-y-12">
          {rendered.map(({ story, Content }) => (
            <article class="max-w-3xl">
              <h3 class="text-xl font-bold text-ink">{story.data.title}</h3>
              <p class="mt-2 text-ink-soft">{story.data.summary}</p>
              {(story.data.person || story.data.location) && (
                <p class="mt-4 text-sm font-medium text-muted">
                  {[story.data.person, story.data.location].filter(Boolean).join(' · ')}
                </p>
              )}
              <div class="prose mt-6">
                <Content />
              </div>
              <div class="mt-8">
                <Comments page={`impact/${story.id}`} heading="Comments on this story" />
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="mt-6 max-w-2xl text-ink-soft">
          We are preparing to share the stories of the founders we work with.
          Check back soon, or
          <a class="text-primary underline" href="/contact">get in touch</a> to hear more.
        </p>
      )
    }
  </Section>

  <CTASection />
</BaseLayout>
