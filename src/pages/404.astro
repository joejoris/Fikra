---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" noindex>
  <Section>
    <div class="mx-auto max-w-xl text-center">
      <p class="text-5xl font-bold text-primary">404</p>
      <h1 class="mt-4 text-3xl font-bold">We could not find that page</h1>
      <p class="mt-4 text-lg text-ink-soft">
        The page may have moved or the address may be mistyped.
      </p>
      <div class="mt-8 flex justify-center gap-3">
        <Button href="/" variant="primary">Back to home</Button>
        <Button href="/contact" variant="outline">Contact us</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
