---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import Turnstile from '../components/Turnstile.astro';
import CTASection from '../components/CTASection.astro';

const events = (
  await getCollection('events', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  )
).sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());

const startOfToday = new Date();
startOfToday.setUTCHours(0, 0, 0, 0);
const upcoming = events.filter(
  (event) => (event.data.endDate ?? event.data.startDate) >= startOfToday,
);

const fmtLong = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

const gcalDate = (date: Date) =>
  `${date.getUTCFullYear()}${String(date.getUTCMonth() + 1).padStart(2, '0')}${String(
    date.getUTCDate(),
  ).padStart(2, '0')}`;

const googleCalendarUrl = (event: (typeof events)[number]) => {
  const start = gcalDate(event.data.startDate);
  const end = gcalDate(event.data.endDate ?? event.data.startDate);
  const params = new URLSearchParams({
    action: 'TEMPLATE',
    text: event.data.title,
    dates: `${start}/${end}`,
    details: event.data.summary,
    location: event.data.location ?? '',
  });
  return `https://calendar.google.com/calendar/render?${params.toString()}`;
};
---

<BaseLayout
  title="Events"
  description="Upcoming FIKRA events, information sessions and application deadlines."
>
  <Section>
    <PageHero
      eyebrow="Events"
      title="What is coming up"
      intro="Information sessions, workshops and application deadlines. Add them straight to your calendar."
    />
  </Section>

  <Section tone="white">
    {
      upcoming.length > 0 ? (
        <div>
          <p class="mb-8 text-sm text-muted">
            Subscribe to the full calendar:
            <a class="text-primary underline" href="/events.ics">add all events (.ics)</a>
          </p>
          <ul class="space-y-6">
            {upcoming.map((event) => (
              <li class="rounded-[var(--radius-card)] border border-border bg-surface p-6 shadow-[var(--shadow-card)]">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <time
                      class="text-sm font-semibold uppercase tracking-wide text-primary"
                      datetime={event.data.startDate.toISOString()}
                    >
                      {fmtLong(event.data.startDate)}
                      {event.data.startTime && ` · ${event.data.startTime}`}
                    </time>
                    <h2 class="mt-2 text-xl font-bold text-ink">{event.data.title}</h2>
                    <p class="mt-2 max-w-2xl text-ink-soft">{event.data.summary}</p>
                    {event.data.location && (
                      <p class="mt-3 text-sm text-muted">{event.data.location}</p>
                    )}
                  </div>
                  <div class="flex shrink-0 flex-wrap gap-2">
                    <a
                      class="inline-flex items-center rounded-lg border border-primary px-3 py-2 text-sm font-semibold text-primary hover:bg-primary-soft"
                      href={googleCalendarUrl(event)}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Add to calendar
                    </a>
                    {event.data.registrationUrl && (
                      <a
                        class="inline-flex items-center rounded-lg bg-primary px-3 py-2 text-sm font-semibold text-white hover:bg-primary-dark"
                        href={event.data.registrationUrl}
                      >
                        Register
                      </a>
                    )}
                  </div>
                </div>
                {!event.data.registrationUrl && (
                  <details class="mt-5 rounded-xl bg-soft p-4">
                    <summary class="cursor-pointer text-sm font-semibold text-primary">
                      Register for this event
                    </summary>
                    <form
                      class="mt-4 space-y-4"
                      data-form
                      novalidate
                      action="/api/rsvp"
                      method="post"
                      data-success="inline"
                      data-success-message="You are registered — check your email for confirmation."
                    >
                      <input type="hidden" name="event_slug" value={event.id} />
                      <input type="hidden" name="event_title" value={event.data.title} />
                      <input type="hidden" name="_loadedAt" value="" data-loaded-at />

                      {/* Honeypot: hidden from humans, tempting to bots. */}
                      <div class="hidden" aria-hidden="true">
                        <label for={`rsvp-${event.id}-gotcha`}>Leave this field empty</label>
                        <input
                          id={`rsvp-${event.id}-gotcha`}
                          type="text"
                          name="_gotcha"
                          tabindex="-1"
                          autocomplete="off"
                        />
                      </div>

                      <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                          <label
                            class="block text-sm font-semibold text-ink"
                            for={`rsvp-${event.id}-name`}
                          >
                            Full name
                          </label>
                          <input
                            class="mt-1 w-full rounded-lg border border-border bg-surface px-3 py-2.5 text-sm"
                            id={`rsvp-${event.id}-name`}
                            name="name"
                            type="text"
                            autocomplete="name"
                            required
                          />
                        </div>
                        <div>
                          <label
                            class="block text-sm font-semibold text-ink"
                            for={`rsvp-${event.id}-email`}
                          >
                            Email
                          </label>
                          <input
                            class="mt-1 w-full rounded-lg border border-border bg-surface px-3 py-2.5 text-sm"
                            id={`rsvp-${event.id}-email`}
                            name="email"
                            type="email"
                            autocomplete="email"
                            required
                          />
                        </div>
                      </div>

                      <div>
                        <label
                          class="block text-sm font-semibold text-ink"
                          for={`rsvp-${event.id}-guests`}
                        >
                          Attendees <span class="font-normal text-muted">(including you)</span>
                        </label>
                        <input
                          class="mt-1 w-32 rounded-lg border border-border bg-surface px-3 py-2.5 text-sm"
                          id={`rsvp-${event.id}-guests`}
                          name="guests"
                          type="number"
                          min="1"
                          max="20"
                          value="1"
                          required
                        />
                      </div>

                      <div class="flex items-start gap-3">
                        <input
                          class="mt-1 h-4 w-4 rounded border-border"
                          id={`rsvp-${event.id}-consent`}
                          name="consent"
                          type="checkbox"
                          value="yes"
                          required
                        />
                        <label class="text-sm text-ink-soft" for={`rsvp-${event.id}-consent`}>
                          I agree that FIKRA may store these details to manage my
                          registration. See our
                          <a class="text-primary underline" href="/privacy">privacy policy</a>.
                        </label>
                      </div>

                      <Turnstile />

                      <div class="flex items-center gap-4">
                        <button
                          class="inline-flex items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-dark disabled:opacity-60"
                          type="submit"
                          data-submit
                        >
                          Register
                        </button>
                        <p class="text-sm text-muted" data-status role="status" aria-live="polite"></p>
                      </div>
                    </form>
                  </details>
                )}
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <p class="max-w-2xl text-ink-soft">
          There are no events scheduled right now. Check back soon, or
          <a class="text-primary underline" href="/contact">contact us</a> to be told first.
        </p>
      )
    }
  </Section>

  <CTASection />
</BaseLayout>

<script>
  import { initForms } from '../scripts/forms';
  initForms();
</script>
