---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Thank you" noindex>
  <Section>
    <div class="mx-auto max-w-xl text-center">
      <p class="text-5xl" aria-hidden="true">✓</p>
      <h1 class="mt-4 text-3xl font-bold">Thank you</h1>
      <p class="mt-4 text-lg text-ink-soft">
        Your message has been sent. We will get back to you as soon as we can.
      </p>
      <div class="mt-8 flex justify-center gap-3">
        <Button href="/" variant="primary">Back to home</Button>
        <Button href="/programs" variant="outline">Explore programs</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
