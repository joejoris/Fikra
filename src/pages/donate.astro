---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { DONATION, SITE } from '../lib/site';

const methods = DONATION.methods;
const hasMethods = methods.length > 0;
const firstLink = methods.find((method) => method.kind === 'link' && method.url);
const showPresets = DONATION.presets.length > 0 && !!firstLink;

const withAmount = (url: string, amount: number) => {
  if (!DONATION.amountParam) return url;
  try {
    const parsed = new URL(url);
    parsed.searchParams.set(DONATION.amountParam, String(amount));
    return parsed.toString();
  } catch {
    return url;
  }
};
---

<BaseLayout
  title="Donate"
  description="Support young founders to turn ideas into sustainable enterprises."
>
  <Section>
    <PageHero
      eyebrow="Support our work"
      title="Your giving turns ideas into income"
      intro="Every contribution goes directly to the programmes that help young people start and grow real businesses."
    />
  </Section>

  <Section tone="white">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div class="prose">
        <h2>What your support funds</h2>
        <ul>
          <li>Training and materials for a cohort of first-time founders</li>
          <li>Small startup grants for founders reaching first revenue</li>
          <li>Mentor coordination and matching</li>
          <li>Workspace, internet and the everyday costs of running programmes</li>
        </ul>
        <h2>Accountability</h2>
        <p>
          FIKRA is governed by its constitution and reports on progress against
          its strategic plan. Our governance documents are
          <a href="/documents">available to download</a>, and if you would like to
          ask anything before you give, please do.
        </p>
      </div>

      <aside class="rounded-[var(--radius-card)] border border-border bg-bg p-6">
        {DONATION.goal.target > 0 && (
          <div class="mb-6 border-b border-border pb-6">
            <div class="flex items-baseline justify-between gap-3 text-sm">
              <span class="font-semibold text-ink">{DONATION.goal.label || 'Fundraising goal'}</span>
              <span class="text-ink-soft">
                {DONATION.goal.currency} {DONATION.goal.raised.toLocaleString('en-US')} of{' '}
                {DONATION.goal.currency} {DONATION.goal.target.toLocaleString('en-US')}
              </span>
            </div>
            <div
              class="mt-3 h-3 overflow-hidden rounded-full bg-border"
              role="progressbar"
              aria-valuenow={Math.min(100, Math.round((DONATION.goal.raised / DONATION.goal.target) * 100))}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-label={DONATION.goal.label || 'Fundraising goal'}
            >
              <div
                class="h-full rounded-full bg-gradient-to-r from-primary to-accent"
                style={`width: ${Math.min(100, Math.round((DONATION.goal.raised / DONATION.goal.target) * 100))}%`}
              ></div>
            </div>
          </div>
        )}
        {
          hasMethods ? (
            <div>
              <h2 class="text-lg font-bold">Give now</h2>

              {showPresets && (
                <div class="mt-4">
                  <p class="text-sm text-ink-soft">Choose an amount{DONATION.currency && ` (${DONATION.currency})`}:</p>
                  <div class="mt-2 flex flex-wrap gap-2">
                    {DONATION.presets.map((amount) => (
                      <a
                        class="rounded-lg border border-primary px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-soft"
                        href={withAmount(firstLink!.url!, amount)}
                      >
                        {DONATION.currency} {amount}
                      </a>
                    ))}
                  </div>
                </div>
              )}

              <div class="mt-5 space-y-4">
                {methods.map((method) =>
                  method.kind === 'bank' ? (
                    <div>
                      <h3 class="text-sm font-bold text-ink">{method.label}</h3>
                      {method.description && (
                        <p class="mt-1 text-sm text-ink-soft">{method.description}</p>
                      )}
                      <dl class="mt-3 space-y-2 text-sm">
                        {method.accounts?.map((account) => (
                          <div class="rounded-lg border border-border bg-surface p-3">
                            <dt class="font-semibold text-ink">{account.name}</dt>
                            <dd class="mt-1 text-ink-soft">
                              {account.bank}
                              <br />
                              Account {account.number}
                              {account.swift && (
                                <>
                                  <br />
                                  SWIFT {account.swift}
                                </>
                              )}
                              {account.note && (
                                <>
                                  <br />
                                  {account.note}
                                </>
                              )}
                            </dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  ) : (
                    <div>
                      <Button href={method.url ?? '#'} variant="accent" size="lg" class="w-full">
                        {method.label}
                      </Button>
                      {method.description && (
                        <p class="mt-2 text-sm text-ink-soft">{method.description}</p>
                      )}
                    </div>
                  ),
                )}
              </div>
            </div>
          ) : (
            <div>
              <h2 class="text-lg font-bold">Online giving is coming soon</h2>
              <p class="mt-2 text-sm text-ink-soft">{DONATION.note}</p>
              <ul class="mt-4 space-y-2 text-sm">
                <li>
                  Email
                  <a class="text-primary underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
                </li>
              </ul>
              <Button href="/contact" variant="primary" size="md" class="mt-5 w-full">
                Contact us to give
              </Button>
            </div>
          )
        }

        <div data-paypal-panel class="mt-6 hidden border-t border-border pt-6">
          <h2 class="text-lg font-bold">Give with PayPal</h2>
          <p class="mt-2 text-sm text-ink-soft">
            Secure payment via PayPal<span data-paypal-currency-note></span>. You
            can pay with a PayPal account or a card.
          </p>
          <div class="mt-4">
            <p class="text-sm font-semibold text-ink">Choose an amount:</p>
            <div class="mt-2 flex flex-wrap gap-2" data-paypal-presets>
              {(DONATION.presets.length > 0 ? DONATION.presets : [10, 25, 50, 100]).map((amount) => (
                <button
                  type="button"
                  data-paypal-preset={amount}
                  class="rounded-lg border border-primary px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-soft"
                >
                  <span data-paypal-code>USD</span> {amount}
                </button>
              ))}
            </div>
            <label class="mt-4 block text-sm font-semibold text-ink" for="paypal-amount">
              Or enter an amount
            </label>
            <div class="mt-1 flex gap-2">
              <input
                class="w-full rounded-lg border border-border bg-surface px-3 py-2.5 text-sm"
                id="paypal-amount"
                name="amount"
                type="number"
                min="1"
                max="100000"
                step="0.01"
                value="25"
                required
              />
              <button
                type="button"
                data-paypal-submit
                class="inline-flex shrink-0 items-center justify-center rounded-lg bg-gradient-to-r from-accent to-accent-dark px-5 py-2.5 text-sm font-bold text-ink transition-all duration-200 hover:-translate-y-0.5 disabled:opacity-60"
              >
                Donate
              </button>
            </div>
            <p class="mt-3 hidden text-sm text-red-600" data-paypal-status role="status" aria-live="polite"></p>
          </div>
        </div>

        <div data-mpesa-panel class="mt-6 hidden border-t border-border pt-6">
          <h2 class="text-lg font-bold">Give with M-Pesa</h2>
          <p class="mt-2 text-sm text-ink-soft">
            Enter your Safaricom number and amount — we send a payment prompt
            to your phone and you approve it with your M-Pesa PIN.
          </p>
          <div class="mt-4 space-y-3">
            <div>
              <label class="block text-sm font-semibold text-ink" for="mpesa-phone">
                M-Pesa phone number
              </label>
              <input
                class="mt-1 w-full rounded-lg border border-border bg-surface px-3 py-2.5 text-sm"
                id="mpesa-phone"
                name="phone"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                placeholder="0712 345 678"
                required
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-ink" for="mpesa-amount">
                Amount (KES)
              </label>
              <input
                class="mt-1 w-full rounded-lg border border-border bg-surface px-3 py-2.5 text-sm"
                id="mpesa-amount"
                name="amount"
                type="number"
                min="1"
                max="500000"
                step="1"
                value="100"
                required
              />
            </div>
            <button
              type="button"
              data-mpesa-submit
              class="inline-flex w-full items-center justify-center rounded-lg bg-gradient-to-r from-primary to-primary-dark px-5 py-2.5 text-sm font-bold text-white transition-all duration-200 hover:-translate-y-0.5 disabled:opacity-60"
            >
              Send M-Pesa prompt
            </button>
            <p class="hidden text-sm text-ink-soft" data-mpesa-status role="status" aria-live="polite"></p>
          </div>
        </div>
      </aside>
    </div>
  </Section>

  <Section tone="soft">
    <h2 class="text-2xl font-bold">Prefer to give in another way?</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      We welcome in-kind support, equipment, and introductions to funders. If
      you would like to discuss a gift, get in touch and we will find the
      simplest way that works for you.
    </p>
    <div class="mt-6">
      <Button href="/contact" variant="outline" size="lg">Talk to us</Button>
    </div>
  </Section>
</BaseLayout>

<script>
  // PayPal panel: only shown when the server has PayPal credentials configured.
  const panel = document.querySelector('[data-paypal-panel]');
  if (panel) {
    fetch('/api/donate/paypal/status')
      .then((res) => res.json())
      .then((status) => {
        if (!status || status.enabled !== true) {
          panel.remove();
          return;
        }
        panel.classList.remove('hidden');
        panel.querySelectorAll('[data-paypal-code]').forEach((el) => {
          el.textContent = status.currency || 'USD';
        });
        const note = panel.querySelector('[data-paypal-currency-note]');
        if (note) note.textContent = ` (${status.currency || 'USD'})`;

        const input = panel.querySelector<HTMLInputElement>('#paypal-amount');
        panel.querySelectorAll('[data-paypal-preset]').forEach((button) => {
          button.addEventListener('click', () => {
            if (input && button instanceof HTMLElement) {
              input.value = button.dataset.paypalPreset ?? '';
            }
          });
        });

        const submit = panel.querySelector<HTMLButtonElement>('[data-paypal-submit]');
        const feedback = panel.querySelector('[data-paypal-status]');
        submit?.addEventListener('click', async () => {
          if (feedback) {
            feedback.textContent = '';
            feedback.classList.add('hidden');
          }
          const amount = Number(input?.value);
          if (submit) {
            submit.disabled = true;
            submit.textContent = 'Redirecting…';
          }
          try {
            const res = await fetch('/api/donate/paypal/create', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ amount }),
            });
            const data = await res.json();
            if (!res.ok || !data.approvalUrl) {
              throw new Error(data?.error || 'Could not start the payment.');
            }
            window.location.assign(data.approvalUrl);
          } catch (error) {
            if (feedback) {
              feedback.textContent =
                error instanceof Error
                  ? error.message
                  : 'We could not start the payment just now. Please try again in a moment, or email us at fikrainnovator9@gmail.com.';
              feedback.classList.remove('hidden');
            }
            if (submit) {
              submit.disabled = false;
              submit.textContent = 'Donate';
            }
          }
        });
      })
      .catch(() => {
        panel.remove();
      });
  }
</script>

<script>
  // M-Pesa panel: only shown when the server has Daraja credentials configured.
  const mpesaPanel = document.querySelector('[data-mpesa-panel]');
  if (mpesaPanel) {
    const setStatus = (message: string, isError: boolean) => {
      const el = mpesaPanel.querySelector('[data-mpesa-status]');
      if (!el) return;
      el.textContent = message;
      el.classList.remove('hidden');
      el.classList.toggle('text-red-600', isError);
    };

    fetch('/api/donate/mpesa/status')
      .then((res) => res.json())
      .then((status) => {
        if (!status || status.enabled !== true) {
          mpesaPanel.remove();
          return;
        }
        mpesaPanel.classList.remove('hidden');

        const phoneInput = mpesaPanel.querySelector<HTMLInputElement>('#mpesa-phone');
        const amountInput = mpesaPanel.querySelector<HTMLInputElement>('#mpesa-amount');
        const submit = mpesaPanel.querySelector<HTMLButtonElement>('[data-mpesa-submit]');

        const pollResult = (checkoutRequestId: string, attemptsLeft: number) => {
          if (attemptsLeft <= 0) {
            setStatus(
              'We have not seen your payment yet. If you approved it on your phone, it will still be recorded — otherwise try again.',
              true,
            );
            if (submit) {
              submit.disabled = false;
              submit.textContent = 'Send M-Pesa prompt';
            }
            return;
          }
          window.setTimeout(async () => {
            try {
              const res = await fetch(
                `/api/donate/mpesa/result?id=${encodeURIComponent(checkoutRequestId)}`,
              );
              const data = await res.json();
              if (data.completed === true) {
                window.location.assign('/donate/thanks?status=success');
                return;
              }
            } catch {
              // Keep polling through transient errors.
            }
            pollResult(checkoutRequestId, attemptsLeft - 1);
          }, 3000);
        };

        submit?.addEventListener('click', async () => {
          const phone = phoneInput?.value ?? '';
          const amount = Number(amountInput?.value);
          if (submit) {
            submit.disabled = true;
            submit.textContent = 'Sending…';
          }
          try {
            const res = await fetch('/api/donate/mpesa/stk', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ phone, amount }),
            });
            const data = await res.json();
            if (!res.ok || !data.checkoutRequestId) {
              throw new Error(data?.error || 'Could not send the prompt.');
            }
            setStatus('Prompt sent — check your phone and enter your M-Pesa PIN to complete the gift.', false);
            pollResult(data.checkoutRequestId, 40);
          } catch (error) {
            setStatus(
              error instanceof Error
                ? error.message
                : 'We could not send the M-Pesa prompt just now. Please try again in a moment, or email us at fikrainnovator9@gmail.com.',
              true,
            );
            if (submit) {
              submit.disabled = false;
              submit.textContent = 'Send M-Pesa prompt';
            }
          }
        });
      })
      .catch(() => {
        mpesaPanel.remove();
      });
  }
</script>
